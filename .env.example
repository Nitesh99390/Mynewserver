# ============ Master bot (bot.py) — REQUIRED ============
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=
# Extra admins, comma separated (optional)
ADMIN_IDS=

# ============ Workers ============
# Must equal WORKER_SECRET on every worker. Leave blank to disable auth (not recommended).
WORKER_SECRET=
# Optional: pre-seed worker URLs (comma separated). You can also add them from the admin panel.
WORKERS=
WORKER_TIMEOUT=90
WORKER_COOLDOWN=90
KEEPALIVE_INTERVAL=300
BATCH_ITEMS=40
BATCH_CHARS=4000
PARALLEL_BATCHES=10

# ============ Plans & pricing ============
FREE_DAILY_CHARS=1000000          # 1M characters free per user per day
UNLIMITED_PRICE_INR=100           # ₹100
UNLIMITED_DAYS=30                 # for 30 days
CREDIT_PRICE_PER_MILLION_INR=2    # ₹2 per 1M characters (credits never expire)
MIN_CREDIT_MILLIONS=1
MAX_CREDIT_MILLIONS=500

# ============ Payments (any / both optional) ============
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_ID=
UPI_NAME=EPUB Translator
SUPPORT_CONTACT=@yourusername

# ============ Runtime ============
DATA_DIR=data
MAX_FILE_MB=50
MAX_CONCURRENT_JOBS=3
PENDING_TTL=900
LOG_LEVEL=INFO

# ============ Worker (app.py) — set on Render/Vercel ============
# PORT is set by the host automatically
# WORKER_SECRET=<same as above>
# MAX_CONCURRENCY=8
# MAX_INFLIGHT=16
# UPSTREAM_TIMEOUT=20
